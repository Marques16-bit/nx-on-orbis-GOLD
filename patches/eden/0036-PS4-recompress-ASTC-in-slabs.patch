+            // 0.9.8: decoded and compressed a slab at a time (a few layers, or a band of rows of one big layer), not the whole level
+            // at once: the RGBA8 copy of the whole level was a heap block of 96 MiB for a 2048 x 2048 image of 6 layers.
+            const u32 slices = copy.image_subresource.num_layers * copy.image_extent.depth;
+            const auto plan = Tegra::Texture::AstcSlabs::MakePlan(copy.image_extent.width, copy.image_extent.height, slices,
+                                                                  tile_size.height);
+            decode_scratch.resize_destructive(plan.scratch_bytes);
