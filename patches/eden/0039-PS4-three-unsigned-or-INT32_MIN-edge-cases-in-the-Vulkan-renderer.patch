From 3d23c21536debcd2c267ec2eb667c1834dd1e5ad Mon Sep 17 00:00:00 2001
From: ci <ci@x>
Date: Wed, 25 Nov 2026 20:53:27 -0300
Subject: [PATCH] PS4: three unsigned or INT32_MIN edge cases in the Vulkan
 renderer

0.9.8. Three places of this Eden's Vulkan renderer do arithmetic that
is wrong at an edge. None is known to be reached by a game; all three
are cheap to make safe, and on a GCN GPU a wrong count is a GPU hang
(a console crash), not a graphics glitch.

- MakeDrawParams (QuadStrip): (num_vertices - 2) / 2 * 6 in u32 wraps
  for 0 or 1 vertices into a draw of about 2^32 indices. A strip of
  fewer than 2 vertices has no quad: the count is 0.
- Clear: clamp_rect_to_render_area negates a negative scissor offset as
  an s32; -INT32_MIN is undefined behaviour. The offset is widened to
  s64 first. The values for every other offset are unchanged.
- BufferCacheRuntime::BindVertexBuffers: binding_count was max - min of
  two u32 after clamping, rejected only when exactly zero; a reversed
  range (min above max) wrapped to a huge count handed to Vulkan with
  much smaller arrays. A range that is not ordered and non-empty is
  not bound.

The same three edge cases were found and fixed by the ProsperoEden-
Encore port (docs of 2026-10-16, "clear scissor overflow", "quad strip
draw count", "vertex binding range"); this change was written here
from reading this Eden's code, not copied.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PwQLQy9xSN2RjJRnq5bYjb
---
 src/video_core/renderer_vulkan/vk_buffer_cache.cpp | 5 +++--
 src/video_core/renderer_vulkan/vk_rasterizer.cpp   | 7 +++++--
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
index 5e794ed..1d663ad 100644
--- a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
@@ -670,10 +670,11 @@ void BufferCacheRuntime::BindVertexBuffers(VideoCommon::HostBindings<Buffer>& bi
     const u32 device_max = device.GetMaxVertexInputBindings();
     const u32 min_binding = (std::min)(bindings.min_index, device_max);
     const u32 max_binding = (std::min)(bindings.max_index, device_max);
-    const u32 binding_count = max_binding - min_binding;
-    if (binding_count == 0) {
+    // 0.9.8: a reversed range (min above max) wrapped to a huge binding_count; only an ordered, non-empty range is bound
+    if (max_binding <= min_binding) {
         return;
     }
+    const u32 binding_count = max_binding - min_binding;
     if (device.IsExtExtendedDynamicStateSupported()) {
         scheduler.Record([bindings_ = std::move(bindings), buffer_handles_ = std::move(buffer_handles), binding_count](vk::CommandBuffer cmdbuf) {
             cmdbuf.BindVertexBuffers2EXT(bindings_.min_index, binding_count, buffer_handles_.data(), bindings_.offsets.data(), bindings_.sizes.data(), bindings_.strides.data());
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
index 452e586..69849e3 100644
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -166,7 +166,9 @@ DrawParams MakeDrawParams(const Tegra::Engines::Maxwell3D::DrawManager::State& d
         params.base_vertex = 0;
         params.is_indexed = true;
     } else if (draw_state.topology == Maxwell::PrimitiveTopology::QuadStrip) {
-        params.num_vertices = (params.num_vertices - 2) / 2 * 6;
+        // 0.9.8: with fewer than 2 vertices the unsigned subtraction wrapped to a huge index count (a draw
+        // of billions of indices on a GCN GPU); a strip of fewer than 2 vertices has no quad.
+        params.num_vertices = params.num_vertices >= 2 ? (params.num_vertices - 2) / 2 * 6 : 0;
         params.base_vertex = 0;
         params.is_indexed = true;
     }
@@ -457,7 +459,8 @@ void RasterizerVulkan::Clear(u32 layer_count) {
                 return;
             }
             if (offset < 0) {
-                const u32 shrink = (std::min)(extent, static_cast<u32>(-offset));
+                // 0.9.8: -offset overflows for INT32_MIN (undefined behaviour); widen first
+                const u32 shrink = (std::min)(extent, static_cast<u32>(-static_cast<s64>(offset)));
                 extent -= shrink;
                 offset = 0;
             }
-- 
