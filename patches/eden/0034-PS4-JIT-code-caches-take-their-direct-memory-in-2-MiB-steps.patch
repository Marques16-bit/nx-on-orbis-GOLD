 namespace Dynarmic::Backend::X64 {
 namespace {
 struct OrbisCodeAllocator final : Xbyak::Allocator {
     static constexpr size_t Granule = 0x4000;
+    // 0.9.4 fix 2: first try the block on 2 MiB boundaries, physical and virtual (the way the guest memory's own carve-outs are
+    // taken), which lets the kernel back it with large pages: the code of a core is tens of MiB, and with 16 KiB pages every few
+    // KiB of it needs its own TLB entry. If the kernel has no such block (fragmented direct memory) it is the 16 KiB block as before.
+    static constexpr size_t Large = 0x200000;
+    static constexpr int32_t ProtCpuRw = 0x03;
+    static constexpr int32_t ProtCpuRwx = 0x07;
+    static constexpr int32_t MapFixed = 0x0010;
+
     struct Block {
         uint8_t* addr;
         size_t size;
-        off_t phys;
+        off_t phys;                // a block taken at once: its direct memory
+        bool lazy;                 // reserved address space that gets a Large step of direct memory at a time
+        std::vector<off_t> steps;  // lazy: the direct memory of each step taken so far, from the start of the block
     };
     std::vector<Block> blocks;
-
-    // 0.9.4 fix 2: first try the block on 2 MiB boundaries, physical and virtual (the way the guest memory's own carve-outs are
-    // taken), which lets the kernel back it with large pages: the code of a core is tens of MiB, and with 16 KiB pages every few
-    // KiB of it needs its own TLB entry. If the kernel has no such block (fragmented direct memory) it is the 16 KiB block as before.
-    static constexpr size_t Large = 0x200000;
+    std::mutex mutex;  // the four cores make and grow their caches on their own threads
 
     uint8_t* alloc(size_t size) override {
+        std::lock_guard lock{mutex};
+        if (__atomic_load_n(&ps4_jit_cache_lazy, __ATOMIC_RELAXED) != 0) {
+            if (uint8_t* lazy = AllocLazy(size)) {
+                return lazy;
+            }
+            // The kernel would not reserve, map or promote a step the way a whole block always was: take the whole block below.
+        }
+        return AllocWhole(size);
+    }
+
+    // 0.9.7 (patch 0034): the cache is only reserved; direct memory is taken in Large steps as the code grows (BlockOfCode::EnsureMemoryCommitted,
+    // which Dynarmic calls before each block, as it does on Windows). Four caches of 256 MiB were 1 GiB of the console's 4.5 GiB taken at the
+    // start for code that is a few tens of MiB: Mario Odyssey ended with the free direct block at 44 MiB (VK_ERROR_OUT_OF_DEVICE_MEMORY, or a
+    // lazy guest page that could not be committed). The first two steps (4 MiB: the constant pool and the prelude) are taken here, so a kernel that
+    // refuses a fixed map or the promotion to RWX is found now, when the whole block is still the way out.
+    uint8_t* AllocLazy(size_t size) {
+        const size_t len = (size + Large - 1) & ~(Large - 1);
+        void* base = nullptr;
+        if (sceKernelReserveVirtualRange(&base, len, 0, Large) != 0 || base == nullptr) {
+            return nullptr;
+        }
+        blocks.push_back({static_cast<uint8_t*>(base), len, 0, true, {}});
+        if (!CommitSteps(blocks.back(), 2 * Large)) {
+            DropLast();
+            return nullptr;
+        }
+        __atomic_fetch_add(&ps4_jit_reserved_bytes, static_cast<unsigned long long>(len), __ATOMIC_RELAXED);
+        __atomic_fetch_add(&ps4_jit_cache_large, 1ull, __ATOMIC_RELAXED);
+        return static_cast<uint8_t*>(base);
+    }
+
+    void DropLast() {
+        Block& b = blocks.back();
+        sceKernelMunmap(b.addr, b.size);
+        for (const off_t phys : b.steps) {
+            sceKernelReleaseDirectMemory(phys, Large);
+            __atomic_fetch_sub(&ps4_jit_committed_bytes, static_cast<unsigned long long>(Large), __ATOMIC_RELAXED);
+        }
+        blocks.pop_back();
+    }
+
+    // Takes steps until [block start, block start + bytes) has memory. False if the kernel refused one (the steps taken stay).
+    bool CommitSteps(Block& b, size_t bytes) {
+        const size_t wanted = std::min(b.size / Large, (bytes + Large - 1) / Large);
+        while (b.steps.size() < wanted) {
+            uint8_t* const at = b.addr + b.steps.size() * Large;
+            off_t phys = 0;
+            bool large = true;
+            if (sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), Large, Large, 0 /*WB_ONION*/, &phys) != 0) {
+                large = false;
+                if (sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), Large, Granule, 0 /*WB_ONION*/, &phys) != 0) {
+                    return false;
+                }
+            }
+            void* where = at;
+            if (sceKernelMapDirectMemory(&where, Large, ProtCpuRw, MapFixed, phys, Large) != 0 || where != static_cast<void*>(at)) {
+                sceKernelReleaseDirectMemory(phys, Large);
+                return false;
+            }
+            if (sceKernelMprotect(at, Large, ProtCpuRwx) != 0) {
+                sceKernelMunmap(at, Large);
+                sceKernelReleaseDirectMemory(phys, Large);
+                return false;
+            }
+            b.steps.push_back(phys);
+            __atomic_fetch_add(large ? &ps4_jit_chunks_large : &ps4_jit_chunks_small, 1ull, __ATOMIC_RELAXED);
+            __atomic_fetch_add(&ps4_jit_committed_bytes, static_cast<unsigned long long>(Large), __ATOMIC_RELAXED);
+        }
+        return true;
+    }
+
+    // How many bytes from `base` have memory after this call (a cache taken whole answers with its size; an address that is not one of ours
+    // is answered with `bytes`, there is nothing to do). `failed` is set when the kernel refused a step.
+    size_t Commit(uint8_t* base, size_t bytes, bool& failed) {
+        std::lock_guard lock{mutex};
+        for (Block& b : blocks) {
+            if (b.addr != base) {
+                continue;
+            }
+            if (!b.lazy) {
+                return b.size;
+            }
+            if (!CommitSteps(b, bytes)) {
+                failed = true;
+                __atomic_fetch_add(&ps4_jit_commit_failed, 1ull, __ATOMIC_RELAXED);
+            }
+            return b.steps.size() * Large;
+        }
+        return bytes;
+    }
+
+    // The way every cache was taken until 0.9.6 (and still is with jit_cache_commit=full, in safe mode, and when the kernel refuses a lazy one).
+    uint8_t* AllocWhole(size_t size) {
         for (const size_t align : {Large, Granule}) {
             const size_t len = (size + align - 1) & ~(align - 1);
             off_t phys = 0;
@@ -189,29 +305,44 @@ struct OrbisCodeAllocator final : Xbyak::Allocator {
                 continue;
             }
             void* addr = nullptr;
-            if (sceKernelMapDirectMemory(&addr, len, 0x03 /*CPU RW*/, 0, phys, align) != 0) {
+            if (sceKernelMapDirectMemory(&addr, len, ProtCpuRw, 0, phys, align) != 0) {
                 sceKernelReleaseDirectMemory(phys, len);
                 continue;
             }
-            if (sceKernelMprotect(addr, len, 0x07 /*CPU RWX*/) != 0) {
+            if (sceKernelMprotect(addr, len, ProtCpuRwx) != 0) {
                 sceKernelMunmap(addr, len);
                 sceKernelReleaseDirectMemory(phys, len);
                 continue;
             }
-            blocks.push_back({static_cast<uint8_t*>(addr), len, phys});
+            blocks.push_back({static_cast<uint8_t*>(addr), len, phys, false, {}});
             __atomic_fetch_add(align == Large ? &ps4_jit_cache_large : &ps4_jit_cache_small, 1ull, __ATOMIC_RELAXED);
+            __atomic_fetch_add(&ps4_jit_reserved_bytes, static_cast<unsigned long long>(len), __ATOMIC_RELAXED);
+            __atomic_fetch_add(&ps4_jit_committed_bytes, static_cast<unsigned long long>(len), __ATOMIC_RELAXED);
             return static_cast<uint8_t*>(addr);
         }
         return nullptr;
     }
+
     void free(uint8_t* p) override {
+        std::lock_guard lock{mutex};
         for (size_t i = 0; i < blocks.size(); ++i) {
-            if (blocks[i].addr == p) {
-                sceKernelMunmap(p, blocks[i].size);
-                sceKernelReleaseDirectMemory(blocks[i].phys, blocks[i].size);
-                blocks.erase(blocks.begin() + std::ptrdiff_t(i));
-                return;
+            if (blocks[i].addr != p) {
+                continue;
             }
+            Block& b = blocks[i];
+            sceKernelMunmap(p, b.size);
+            if (b.lazy) {
+                for (const off_t phys : b.steps) {
+                    sceKernelReleaseDirectMemory(phys, Large);
+                }
+                __atomic_fetch_sub(&ps4_jit_committed_bytes, static_cast<unsigned long long>(b.steps.size() * Large), __ATOMIC_RELAXED);
+            } else {
+                sceKernelReleaseDirectMemory(b.phys, b.size);
+                __atomic_fetch_sub(&ps4_jit_committed_bytes, static_cast<unsigned long long>(b.size), __ATOMIC_RELAXED);
+            }
+            __atomic_fetch_sub(&ps4_jit_reserved_bytes, static_cast<unsigned long long>(b.size), __ATOMIC_RELAXED);
+            blocks.erase(blocks.begin() + std::ptrdiff_t(i));
+            return;
         }
     }
     bool useProtect() const override {
@@ -219,7 +350,7 @@ struct OrbisCodeAllocator final : Xbyak::Allocator {
     }
 };
 
-Xbyak::Allocator* CodeAllocator() {
+OrbisCodeAllocator* CodeAllocator() {
     static OrbisCodeAllocator allocator;
     return &allocator;
 }
@@ -255,6 +386,9 @@ bool BlockOfCode::HasHostFeature(HostFeature feature) const noexcept {
 void BlockOfCode::PreludeComplete() {
     prelude_complete = true;
     code_begin = getCurr();
+#ifdef __ORBIS__
+    orbis_ahead = true; // patch 0034: from here on memory is taken a little ahead of the code (EnsureMemoryCommitted)
+#endif
     ClearCache();
     DisableWriting();
 }
@@ -287,9 +421,17 @@ void BlockOfCode::ClearCache() {
 size_t BlockOfCode::SpaceRemaining() const {
     ASSERT(prelude_complete);
     const u8* current_ptr = getCurr<const u8*>();
+#ifdef __ORBIS__
+    // A cache whose next step the kernel refused is as big as what it got: it is flushed when that is full, like any full cache.
+    const size_t limit = std::min<size_t>(maxSize_, orbis_limit);
+    if (current_ptr >= &top_[limit])
+        return 0;
+    return &top_[limit] - current_ptr;
+#else
     if (current_ptr >= &top_[maxSize_])
         return 0;
     return &top_[maxSize_] - current_ptr;
+#endif
 }
 
 void BlockOfCode::EnsureMemoryCommitted([[maybe_unused]] size_t codesize) {
@@ -302,6 +444,26 @@ void BlockOfCode::EnsureMemoryCommitted([[maybe_unused]] size_t codesize) {
         VirtualAlloc(top_, committed_size, MEM_COMMIT, PAGE_EXECUTE_READWRITE);
 #    endif
     }
+#elif defined(__ORBIS__)
+    // Patch 0034: the cache is address space that gets direct memory in 2 MiB steps; [top_, top_ + committed_size) has memory. A cache taken
+    // whole (jit_cache_commit=full) answers with its size and is never asked again.
+    //
+    // While the prelude is made the memory taken with the block is enough. Afterwards a step is asked for while the code still has codesize + 1 MiB
+    // of room, and the cache is taken to codesize + 2 MiB past the code: Dynarmic checks SpaceRemaining() (and flushes a full cache) *before* this
+    // call and then writes one block into what it finds here, so a step the kernel refuses must still leave that block its room. The refusal
+    // is seen by SpaceRemaining() on the next call, which flushes the cache when less than 1 MiB is left.
+    const size_t limit = std::min<size_t>(maxSize_, orbis_limit);
+    const size_t ahead = orbis_ahead ? size_t(1) << 20 : 0;
+    const size_t trigger = std::min<size_t>(limit, size_ + codesize + ahead);
+    if (committed_size >= trigger)
+        return;
+    const size_t wanted = std::min<size_t>(limit, size_ + codesize + 2 * ahead);
+    bool failed = false;
+    committed_size = CodeAllocator()->Commit(top_, wanted, failed);
+    if (failed) {
+        // The kernel gave no more: this cache stays at what it has (SpaceRemaining() sees the limit) and is flushed when it is full.
+        orbis_limit = committed_size;
+    }
 #endif
 }
 
