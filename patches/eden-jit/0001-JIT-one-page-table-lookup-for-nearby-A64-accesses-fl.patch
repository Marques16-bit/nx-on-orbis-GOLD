From e0fa8654b445b573957de47a14a4a57d2d581c41 Mon Sep 17 00:00:00 2001
From: nx-on-orbis <nx-on-orbis@localhost>
Date: Wed, 11 Nov 2026 09:06:38 -0300
Subject: [PATCH] JIT: one page table lookup for nearby A64 accesses (flat
 table)

Accesses whose addresses are one IR value plus constants, within 256 bytes
and with no exclusive, ordered or exception-raising operation between them,
share one A64EdenPageLookup (the page table entry for that page, or 0).
Each access tests it and accesses memory directly, or runs its own full
lookup out of line. Same effect as Eden4's page reuse pass, written for the
flat page table Eden configures; off unless ps4_page_reuse is set.
---
 .../backend/x64/a64_emit_x64_memory.cpp       |  49 ++++
 .../backend/x64/emit_x64_memory.cpp.inc       | 107 +++++++++
 src/dynarmic/src/dynarmic/ir/opcodes.inc      |   1 +
 src/dynarmic/src/dynarmic/ir/opt_passes.cpp   | 226 +++++++++++++++++-
 4 files changed, 382 insertions(+), 1 deletion(-)

diff --git a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64_memory.cpp b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64_memory.cpp
index 8bb2fcf..7c35a99 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64_memory.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/a64_emit_x64_memory.cpp
@@ -431,3 +431,52 @@ void A64EmitX64::EmitCheckMemoryAbort(A64EmitContext&, IR::Inst* inst, Xbyak::La
 }
 
+// nx-on-orbis: the page table entry for a group of nearby accesses (see ir/opt_passes.cpp, PS4PageReusePass),
+// as the emitted lookup of one access leaves it: masked, sign-extended, "absolute" (host - guest), so that
+// [value + vaddr] is the host address of any byte of the page. 0 when the span crosses a page boundary,
+// leaves the address space, or the page must take the callback path (unmapped or marked): the accesses then
+// do their own lookup out of line. Every register is allocated before the first branch.
+void A64EmitX64::EmitA64EdenPageLookup(A64EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const u32 span = static_cast<u32>(args[1].GetImmediateU64());
+    const Xbyak::Reg64 host = ctx.reg_alloc.UseScratchGpr(code, args[0]);
+    const Xbyak::Reg64 tmp = ctx.reg_alloc.ScratchGpr(code);
+    const size_t valid_page_index_bits = conf.page_table_address_space_bits - page_table_const_bits;
+    SharedLabel none = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+
+    // The whole span inside one page?
+    code.mov(tmp.cvt32(), host.cvt32());
+    code.and_(tmp.cvt32(), static_cast<u32>(page_table_const_size - 1));
+    code.cmp(tmp.cvt32(), static_cast<u32>(page_table_const_size - span));
+    code.ja(*none, code.T_NEAR);
+    // Inside the address space (it is range checked, not mirrored)?
+    code.shr(host, int(page_table_const_bits));
+    code.test(host, u32(-(1 << valid_page_index_bits)));
+    code.jnz(*none, code.T_NEAR);
+    code.mov(host, code.qword[r14 + host * 8]);
+    if (conf.page_table_marked_bit) {
+        code.bt(host, *conf.page_table_marked_bit);
+        code.jc(*none, code.T_NEAR);
+    }
+    if (conf.page_table_pointer_mask != 0) {
+        if (std::in_range<s32>(conf.page_table_pointer_mask)) {
+            code.and_(host, static_cast<u32>(conf.page_table_pointer_mask));
+        } else {
+            code.mov(tmp, conf.page_table_pointer_mask);
+            code.and_(host, tmp);
+        }
+    }
+    if (conf.page_table_sign_extension) {
+        code.shl(host, *conf.page_table_sign_extension);
+        code.sar(host, *conf.page_table_sign_extension);
+    }
+    // An empty entry leaves 0 here, which the accesses treat like "take the slow path".
+    code.L(*end);
+    ctx.deferred_emits.emplace_back([=, this] {
+        code.L(*none);
+        code.xor_(host.cvt32(), host.cvt32());
+        code.jmp(*end, code.T_NEAR);
+    });
+    ctx.reg_alloc.DefineValue(code, inst, host);
+}
+
 }  // namespace Dynarmic::Backend::X64
diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.cpp.inc b/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.cpp.inc
index 8bb8be3..5649c80 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.cpp.inc
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64_memory.cpp.inc
@@ -50,8 +50,90 @@ FakeCall AxxEmitX64::FastmemCallback(u64 rip_) {
 }
 
+// nx-on-orbis (ir/opt_passes.cpp, PS4PageReusePass): the full page table lookup of one access whose group
+// lookup gave 0, out of line. The same steps as EmitVAddrLookup<A64EmitContext> for the configuration the
+// pass accepts (absolute offsets, range checked address space, misalignment checked on page boundaries
+// only). On success `page` is the entry (masked, sign-extended) and [page + vaddr] the host address;
+// otherwise it jumps to `abort`. Templated on the config so that the A32 build, where no access is ever
+// grouped, does not need the A64 members.
+template<typename Config>
+inline void PS4ReuseSlowLookup(BlockOfCode& code, [[maybe_unused]] const Config& conf, [[maybe_unused]] size_t bitsize,
+                               Xbyak::Label& abort, [[maybe_unused]] Xbyak::Reg64 vaddr, [[maybe_unused]] Xbyak::Reg64 page,
+                               [[maybe_unused]] Xbyak::Reg64 idx) {
+    if constexpr (requires { conf.page_table_address_space_bits; }) {
+        const size_t valid_page_index_bits = conf.page_table_address_space_bits - page_table_const_bits;
+        if (bitsize != 8 && (conf.detect_misaligned_access_via_page_table & bitsize) != 0) {
+            const u32 align_mask = static_cast<u32>(bitsize / 8 - 1);
+            const u32 page_align_mask = static_cast<u32>(page_table_const_size - 1) & ~align_mask;
+            Xbyak::Label aligned;
+            code.test(vaddr, align_mask);
+            code.jz(aligned);
+            code.mov(page, vaddr);
+            code.and_(page, page_align_mask);
+            code.cmp(page, page_align_mask);
+            code.je(abort, code.T_NEAR);
+            code.L(aligned);
+        }
+        code.mov(idx, vaddr);
+        code.shr(idx, int(page_table_const_bits));
+        code.test(idx, u32(-(1 << valid_page_index_bits)));
+        code.jnz(abort, code.T_NEAR);
+        code.mov(page, code.qword[r14 + idx * 8]);
+        if (conf.page_table_marked_bit) {
+            code.bt(page, *conf.page_table_marked_bit);
+            code.jc(abort, code.T_NEAR);
+        }
+        if (conf.page_table_pointer_mask != 0) {
+            if (std::in_range<s32>(conf.page_table_pointer_mask)) {
+                code.and_(page, static_cast<u32>(conf.page_table_pointer_mask));
+            } else {
+                code.mov(idx, conf.page_table_pointer_mask);
+                code.and_(page, idx);
+            }
+        }
+        if (conf.page_table_sign_extension) {
+            code.shl(page, *conf.page_table_sign_extension);
+            code.sar(page, *conf.page_table_sign_extension);
+        }
+        code.test(page, page);
+        code.jz(abort, code.T_NEAR);
+    } else {
+        code.jmp(abort, code.T_NEAR);  // not reached: A32 accesses are never grouped
+    }
+}
+
 template<std::size_t bitsize, auto callback>
 void AxxEmitX64::EmitMemoryRead(AxxEmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     const bool ordered = IsOrdered(args[2].GetImmediateAccType());
+    // nx-on-orbis: a grouped access (PS4PageReusePass); its group's page table entry is in args[0].
+    if (!args[0].IsImmediate()) {
+        const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+        const Xbyak::Reg64 vaddr = ctx.reg_alloc.UseGpr(code, args[1]);
+        const Xbyak::Reg64 page = ctx.reg_alloc.ScratchGpr(code);
+        const Xbyak::Reg64 idx = ctx.reg_alloc.ScratchGpr(code);
+        const int value_idx = bitsize == 128 ? ctx.reg_alloc.ScratchXmm(code).getIdx() : ctx.reg_alloc.ScratchGpr(code).getIdx();
+        const auto wrapped_fn = read_fallbacks[std::make_tuple(false, bitsize, vaddr.getIdx(), value_idx)];
+        SharedLabel slow = ctx.GenSharedLabel(), abort = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+        code.test(host, host);
+        code.jz(*slow, code.T_NEAR);
+        EmitReadMemoryMov<bitsize>(code, value_idx, host + vaddr, false);
+        ctx.deferred_emits.emplace_back([=, this, &ctx] {
+            code.L(*slow);
+            PS4ReuseSlowLookup(code, conf, bitsize, *abort, vaddr, page, idx);
+            EmitReadMemoryMov<bitsize>(code, value_idx, page + vaddr, false);
+            code.jmp(*end, code.T_NEAR);
+            code.L(*abort);
+            code.call(wrapped_fn);
+            EmitCheckMemoryAbort(ctx, inst, end);
+            code.jmp(*end, code.T_NEAR);
+        });
+        code.L(*end);
+        if constexpr (bitsize == 128) {
+            ctx.reg_alloc.DefineValue(code, inst, Xbyak::Xmm{value_idx});
+        } else {
+            ctx.reg_alloc.DefineValue(code, inst, Xbyak::Reg64{value_idx});
+        }
+        return;
+    }
     const auto fastmem_marker = ShouldFastmem(ctx, inst);
 
@@ -138,4 +220,29 @@ void AxxEmitX64::EmitMemoryWrite(AxxEmitContext& ctx, IR::Inst* inst) {
     auto args = ctx.reg_alloc.GetArgumentInfo(inst);
     const bool ordered = IsOrdered(args[3].GetImmediateAccType());
+    // nx-on-orbis: a grouped access (PS4PageReusePass); its group's page table entry is in args[0].
+    if (!args[0].IsImmediate()) {
+        const Xbyak::Reg64 host = ctx.reg_alloc.UseGpr(code, args[0]);
+        const Xbyak::Reg64 vaddr = ctx.reg_alloc.UseGpr(code, args[1]);
+        const int value_idx = bitsize == 128 ? ctx.reg_alloc.UseXmm(code, args[2]).getIdx() : ctx.reg_alloc.UseGpr(code, args[2]).getIdx();
+        const Xbyak::Reg64 page = ctx.reg_alloc.ScratchGpr(code);
+        const Xbyak::Reg64 idx = ctx.reg_alloc.ScratchGpr(code);
+        const auto wrapped_fn = write_fallbacks[std::make_tuple(false, bitsize, vaddr.getIdx(), value_idx)];
+        SharedLabel slow = ctx.GenSharedLabel(), abort = ctx.GenSharedLabel(), end = ctx.GenSharedLabel();
+        code.test(host, host);
+        code.jz(*slow, code.T_NEAR);
+        EmitWriteMemoryMov<bitsize>(code, host + vaddr, value_idx, false);
+        ctx.deferred_emits.emplace_back([=, this, &ctx] {
+            code.L(*slow);
+            PS4ReuseSlowLookup(code, conf, bitsize, *abort, vaddr, page, idx);
+            EmitWriteMemoryMov<bitsize>(code, page + vaddr, value_idx, false);
+            code.jmp(*end, code.T_NEAR);
+            code.L(*abort);
+            code.call(wrapped_fn);
+            EmitCheckMemoryAbort(ctx, inst, end);
+            code.jmp(*end, code.T_NEAR);
+        });
+        code.L(*end);
+        return;
+    }
     const auto fastmem_marker = ShouldFastmem(ctx, inst);
 
diff --git a/src/dynarmic/src/dynarmic/ir/opcodes.inc b/src/dynarmic/src/dynarmic/ir/opcodes.inc
